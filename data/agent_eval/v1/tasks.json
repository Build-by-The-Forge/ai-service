  {
   "chunk_id": "c-fluid-1",
   "document_id": "doc-fluid",
   "page": 2,
   "text": "Pressure in a static fluid increases with depth because the weight of the fluid above presses on the layer below. The increase equals density times gravity times depth."
  },
  {
   "chunk_id": "c-fluid-2",
   "document_id": "doc-fluid",
   "page": 3,
   "text": "Pascal's principle says a pressure change applied to an enclosed fluid is passed on undiminished to every part of the fluid and to the container walls."
  },
  {
   "chunk_id": "c-fluid-3",
   "document_id": "doc-fluid",
   "page": 5,
   "text": "Buoyant force on a submerged object equals the weight of the fluid the object displaces. An object floats when its average density is lower than the fluid's density."
  },
  {
   "chunk_id": "c-fluid-4",
   "document_id": "doc-fluid",
   "page": 7,
   "text": "A manometer measures pressure by comparing the height of a liquid column with a reference. Gauge pressure ignores the atmosphere while absolute pressure includes it."
  },
  {
   "chunk_id": "c-gene-1",
   "document_id": "doc-genetics",
   "page": 1,
   "text": "A gene is a stretch of DNA that carries the instructions for building one protein. Alleles are the different versions of a gene found in a population."
  },
  {
   "chunk_id": "c-gene-2",
   "document_id": "doc-genetics",
   "page": 4,
   "text": "In a monohybrid cross between two heterozygous parents the expected phenotype ratio of offspring is three dominant to one recessive."
  },
  {
   "chunk_id": "c-gene-3",
   "document_id": "doc-genetics",
   "page": 6,
   "text": "Mitosis produces two identical body cells, while meiosis produces four different sex cells with half the number of chromosomes."
  },
  {
   "chunk_id": "c-study-1",
   "document_id": "doc-study",
   "page": 1,
   "text": "Spaced practice means reviewing a topic several times over days instead of once in a long session. It helps long term recall."
  },
  {
   "chunk_id": "c-study-2",
   "document_id": "doc-study",
   "page": 2,
   "text": "Retrieval practice means testing yourself from memory rather than rereading notes. Short quizzes after a lesson improve retention."
  }
 ],
